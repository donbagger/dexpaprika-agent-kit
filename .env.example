# Copy to .env, then uncomment ONE model block and fill it in. Nothing here is needed for
# pool_radar.py, smoke.py or the no-model signal_agent.py.

# Nebius Token Factory (https://tokenfactory.nebius.com)
# LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# LLM_API_KEY=
# LLM_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# OpenRouter (https://openrouter.ai)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-5.4-mini

# Ollama on your own machine, no key. Start it with OLLAMA_CONTEXT_LENGTH=16384 or more:
# the tool list does not fit in a 4k context.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:9b

# Optional. Every agent works without it. A Dev, Pro or Enterprise key unlocks token-level OHLCV,
# token indicators and pool swaps. Paste the key on its own.
# DEXPAPRIKA_API_KEY=

# pool_radar.py
# RADAR_NETWORK=base
# RADAR_MIN_LIQUIDITY=5000
# RADAR_INTERVAL=300
# DISCORD_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# signal_agent.py
# SIGNAL_POOLS=ethereum:0x88e6a0c2ddd26feeb64f039a2c41296fcb3f5640,solana:Czfq3xZZDmsdGdUyrNLtRhGc47cXcZtLG4crryfu44zE
# SIGNAL_INTERVAL=1h
